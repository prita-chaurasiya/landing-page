<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <title>Human Rights Council of India (HRCI) | Official Membership Portal</title>
  <meta name="description" content="Be a Voice for Human Rights. Join Human Rights Council of India (HRCI) / भारतीय मानवाधिकार परिषद. A National, Non-Political & Secular NGO Registered under Government of India MCA (Section 8). 70,000+ Active Members across 28 States.">
  <meta name="keywords" content="HRCI, Human Rights Council of India, Bharatiya Manavadhikar Parishad, NGO Membership, Human Rights NGO, Legal Aid India, Join HRCI, Haji S Shaikh">
  <meta name="author" content="Human Rights Council of India (HRCI)">
  <link rel="icon" type="image/webp" href="assets/images/hrci-official-logo.webp">
  
  <!-- Open Graph / Facebook / WhatsApp -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.hrcofindia.org/">
  <meta property="og:title" content="Human Rights Council of India (HRCI) | Official Membership Portal">
  <meta property="og:description" content="Join India's leading human rights movement. Official Membership, PVC ID Card, National Recognition, Legal Awareness across 28 States.">
  <meta property="og:image" content="assets/images/hrci-banner-peace.png">

  <!-- Google Fonts: Poppins & Noto Sans Devanagari -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600;700;800&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
  
  <!-- Main Stylesheet -->
  <link rel="stylesheet" href="style.css">

  <!-- Schema.org Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "NGO",
    "name": "Human Rights Council of India",
    "alternateName": "भारतीय मानवाधिकार परिषद",
    "url": "https://www.hrcofindia.org/",
    "logo": "assets/images/hrci-official-logo.webp",
    "foundingDate": "2013-01-11",
    "founder": {
      "@type": "Person",
      "name": "Hon. Shri Haji S. Shaikh"
    },
    "description": "A National, Non-Political & Secular NGO Registered under Government of India MCA - Section 8 Company.",
    "telephone": "+91-9594441319",
    "email": "info@hrcofindia.org",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "New Delhi",
      "addressCountry": "IN"
    }
  }
  </script>
</head>
<body id="top">

  <!-- ======================================================================
       SECTION 0: TOP SLIDING NOTIFICATION ALERT TICKER (MARQUEE SLIDER)
       ====================================================================== -->
  <div class="top-sliding-alert-bar" role="region" aria-label="National Announcements">
    <div class="container alert-slider-container">
      <div class="alert-badge-label">
        <span class="live-dot"></span>
        <span>LATEST UPDATES</span>
      </div>
      <div class="alert-ticker-track-wrap">
        <div class="alert-ticker-track">
          <span class="ticker-item">⚡ <strong>Human Rights Council of India (HRCI) / भारतीय मानवाधिकार परिषद</strong> — Registered under Govt. of India MCA (Section 8 Company)</span>
          <span class="ticker-bullet">•</span>
          <span class="ticker-item">🏛️ <strong>Established:</strong> 11 January 2013 | Over 70,000+ Active Members Across 28 States &amp; UTs</span>
          <span class="ticker-bullet">•</span>
          <span class="ticker-item">📞 <strong>24/7 National Citizen Helpline:</strong> +91 95944 41319 / +91 95944 41315</span>
          <span class="ticker-bullet">•</span>
          <span class="ticker-item">💳 <strong>Membership Drive 2026:</strong> Annual &amp; Lifetime Registrations Open — Official PVC ID Card Issued</span>
          <span class="ticker-bullet">•</span>
          <span class="ticker-item">🌍 <strong>Upcoming:</strong> Global Peace Summit &amp; National Foundation Conclave</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ======================================================================
       SECTION 1: TOP BRANDING HEADER & STICKY GLASSMORPHIC NAVBAR
       ====================================================================== -->
  <header class="top-branding-header">
    <div class="container top-branding-inner">
      <!-- Left: Official Emblem & Bilingual Organization Name -->
      <div class="brand-block-left">
        <a href="#top" class="brand-emblem-wrapper" title="Human Rights Council of India">
          <img src="assets/images/hrci-navbar-logo.svg" alt="HRCI Official Emblem" width="46" height="46">
        </a>
        <div class="brand-text-column">
          <a href="#top" class="brand-title-red">
            HUMAN RIGHTS COUNCIL OF INDIA (HRCI)<sup>®</sup>
          </a>
          <a href="#top" class="brand-title-blue">
            भारतीय मानवाधिकार परिषद
          </a>
        </div>
        <div class="brand-mca-column">
          <span class="brand-mca-line1">A National, Non-Political &amp; Secular NGO</span>
          <span class="brand-mca-line2">Registered under Government of India</span>
          <span class="brand-mca-line3">MCA – Section 8 Company</span>
        </div>
      </div>

      <!-- Center: Established Laurel Badge -->
      <div class="header-laurel-badge" title="Established 11 Jan 2013">
        <img src="assets/images/established-laurel.svg" alt="Established 11 Jan 2013" width="130" height="46">
      </div>

      <!-- Right: Direct Helpline & YouTube Action Card -->
      <div class="header-right-actions">
        <a href="https://wa.me/919594441319?text=Hello%20HRCI%20Team,%20I%20want%20to%20join%20HRCI%20Membership" target="_blank" rel="noopener" class="header-action-pill pill-whatsapp" title="Chat on WhatsApp">
          <span class="pill-icon">💬</span>
          <span class="pill-text">+91 95944 41319</span>
        </a>
        <a href="tel:+919594441315" class="header-action-pill pill-call" title="Call National Secretariat">
          <span class="pill-icon">📞</span>
          <span class="pill-text">Helpline</span>
        </a>
        <a href="https://youtube.com/@HRC4India" target="_blank" rel="noopener" class="header-yt-card" title="HRC4India Official YouTube Channel">
          <span class="yt-play-badge">▶</span>
          <div class="yt-card-text">
            <span class="yt-channel-name">HRC4India</span>
            <span class="yt-channel-sub">(YouTube Channel)</span>
          </div>
        </a>
      </div>
    </div>
  </header>

  <!-- Sticky Glassmorphic Navigation Bar (Single Landing Page In-Page Anchors) -->
  <nav class="sleek-blue-navbar" id="mainNavbar">
    <div class="container navbar-inner-flex">
      <!-- Left: Glossy Red Join Membership CTA -->
      <a href="#membership-form" class="btn-nav-red-pill">
        <span>Join Membership</span>
        <span>➔</span>
      </a>

      <!-- In-Page Anchor Links (Mobile Drawer & Desktop Menu) -->
      <div class="navbar-nav-list" id="navbarList">
        <!-- Mobile Drawer Header with Exit Cross (✕) Button -->
        <div class="drawer-header-bar">
          <div class="drawer-title-brand">
            <img src="assets/images/hrci-navbar-logo.svg" alt="HRCI Seal" class="drawer-logo-mini">
            <span>HRCI National Portal</span>
          </div>
          <button class="drawer-close-btn" id="drawerCloseBtn" aria-label="Close Menu">✕</button>
        </div>

        <!-- Single Page Anchor Items -->
        <div class="nav-link-item">
          <a href="#top" class="nav-anchor active-home">
            <span class="home-icon-svg">🏠</span>
            <span>Home</span>
          </a>
        </div>

        <div class="nav-link-item">
          <a href="#why-join" class="nav-anchor">
            <span>Why Join</span>
          </a>
        </div>

        <div class="nav-link-item">
          <a href="#focus-areas" class="nav-anchor">
            <span>Focus Areas</span>
          </a>
        </div>

        <div class="nav-link-item">
          <a href="#about" class="nav-anchor">
            <span>About HRCI</span>
          </a>
        </div>

        <div class="nav-link-item">
          <a href="#videos" class="nav-anchor">
            <span>Videos</span>
          </a>
        </div>

        <div class="nav-link-item">
          <a href="#testimonials" class="nav-anchor">
            <span>Members Say</span>
          </a>
        </div>

        <div class="nav-link-item">
          <a href="#plans" class="nav-anchor">
            <span>Plans</span>
          </a>
        </div>

        <div class="nav-link-item">
          <a href="#process" class="nav-anchor">
            <span>Process</span>
          </a>
        </div>

        <div class="nav-link-item">
          <a href="#faq" class="nav-anchor">
            <span>FAQ</span>
          </a>
        </div>

        <div class="nav-link-item">
          <a href="#contact" class="nav-anchor">
            <span>Contact</span>
          </a>
        </div>
      </div>

      <!-- Right: Mobile Hamburger Toggle -->
      <button class="mobile-hamburger" id="navHamburger" aria-label="Toggle Navigation Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <!-- ======================================================================
       SECTION 2: FULL-SCREEN HERO (100VH) - MATCHING POSTER COMPOSITION
       ====================================================================== -->
  <section class="hero-section" id="home">
    <div class="hero-bg-overlay"></div>
    <div class="hero-light-rays"></div>

    <div class="container hero-container">
      <!-- Left Content Column -->
      <div class="hero-content">
        <div class="hero-badge-pill" data-aos="fade-down">
          <span>🇮🇳</span> National Human Rights Organization • Govt. Regd. Section 8
        </div>

        <h1 class="hero-title" data-aos="fade-up">
          Be a Voice for <span class="highlight">Human Rights</span>
        </h1>

        <!-- Yellow/Gold Sub-Banner Matching Poster -->
        <div class="hero-gold-call-banner" data-aos="fade-up" data-aos-delay="100">
          Join HRCI Membership
        </div>

        <p class="hero-tagline" data-aos="fade-up" data-aos-delay="200">
          For Justice, Equality, Social Welfare &amp; Nation Building.
        </p>

        <!-- 3 Feature Checkpoints -->
        <div class="hero-checklist" data-aos="fade-up" data-aos-delay="300">
          <div class="hero-check-item">
            <span class="check-icon">✓</span>
            <span>Be a Member</span>
          </div>
          <div class="hero-check-item">
            <span class="check-icon">✓</span>
            <span>Support Society</span>
          </div>
          <div class="hero-check-item">
            <span class="check-icon">✓</span>
            <span>Create Impact</span>
          </div>
        </div>

        <!-- High Conversion Action Buttons -->
        <div class="hero-cta-group" data-aos="fade-up" data-aos-delay="400">
          <a href="#membership-form" class="btn btn-primary-red">
            <span>Join HRCI Membership Now →</span>
          </a>

          <a href="https://wa.me/919594441319?text=Hello%20HRCI,%20I%20want%20to%20join%20HRCI%20Membership" target="_blank" rel="noopener" class="btn btn-whatsapp">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
            <span>Chat on WhatsApp</span>
          </a>

          <a href="#videos" class="btn btn-outline-gold">
            <span>▶ Watch Video</span>
          </a>
        </div>

        <!-- Trust Badges Strip Under Hero CTA -->
        <div class="hero-trust-badges">
          <span>🔒 100% Verified NGO</span>
          <span>•</span>
          <span>🪪 Instant Digital ID</span>
          <span>•</span>
          <span>⚡ 70,000+ Strong Network</span>
        </div>
      </div>

      <!-- Right Visual Composition (Lady Justice + Indian Flag + Peace Award) -->
      <div class="hero-visual-wrapper" data-aos="zoom-in" data-aos-delay="200">
        <div class="hero-flag-glow" title="Indian Tricolor">
          <img src="assets/images/indian-flag.jpg" alt="Indian National Flag" loading="lazy">
        </div>

        <div class="hero-justice-statue" title="Golden Lady Justice">
          <img src="assets/images/lady-justice-gold.svg" alt="Golden Lady Justice Statue">
        </div>

        <div class="hero-award-badge" title="HRCI Global Peace Award">
          <img src="assets/images/peace-award-gold.svg" alt="HRCI Global Peace Award">
        </div>
      </div>
    </div>

    <!-- Animated Bouncing Scroll Indicator -->
    <a href="#stats" class="hero-scroll-indicator" aria-label="Scroll to Statistics">
      <span>Scroll Down To Explore</span>
      <div class="scroll-mouse">
        <div class="scroll-wheel"></div>
      </div>
    </a>
  </section>

  <!-- ======================================================================
       SECTION 3: TRUST STATISTICS STRIP (COUNTER CARDS)
       ====================================================================== -->
  <section class="stats-strip-section" id="stats" aria-label="Key Statistics">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card" data-aos="fade-up" data-aos-delay="100">
          <div class="stat-icon-box" style="color:var(--cta-red);">👥</div>
          <div class="stat-info">
            <div class="stat-number" data-target="70000" data-suffix="+">70,000+</div>
            <div class="stat-label">Active Members</div>
          </div>
        </div>

        <div class="stat-card" data-aos="fade-up" data-aos-delay="200">
          <div class="stat-icon-box" style="color:var(--saffron);">🇮🇳</div>
          <div class="stat-info">
            <div class="stat-number" data-target="28" data-suffix=" States">28 States</div>
            <div class="stat-label">(Active Pan-India)</div>
          </div>
        </div>

        <div class="stat-card" data-aos="fade-up" data-aos-delay="300">
          <div class="stat-icon-box" style="color:var(--secondary);">🤝</div>
          <div class="stat-info">
            <div class="stat-number" data-target="20000" data-suffix="+">20,000+</div>
            <div class="stat-label">People Assisted</div>
          </div>
        </div>

        <div class="stat-card" data-aos="fade-up" data-aos-delay="400">
          <div class="stat-icon-box" style="color:#059669;">📅</div>
          <div class="stat-info">
            <div class="stat-number">11 Jan 2013</div>
            <div class="stat-label">Since (Established)</div>
          </div>
        </div>

        <div class="stat-card" data-aos="fade-up" data-aos-delay="500">
          <div class="stat-icon-box" style="color:var(--gold-400);">🎖️</div>
          <div class="stat-info">
            <div class="stat-number" data-target="13" data-suffix="+ Years">13+ Years</div>
            <div class="stat-label">Years of Nationwide Service</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       SECTION 4: FOCUS AREAS STRIP (6 LUXURY FOCUS CARDS)
       ====================================================================== -->
  <section class="focus-strip-section" id="focus-areas">
    <div class="container">
      <div class="focus-strip-container" data-aos="fade-up">
        <div class="focus-title-block">
          <h3>Our<br>Focus Areas</h3>
          <span class="focus-sub">Nationwide Service</span>
        </div>

        <div class="focus-items-strip">
          <a href="#membership-form" class="focus-strip-item">
            <div class="focus-icon-circle">⚖️</div>
            <span class="focus-item-name">Legal Awareness &amp; Guidance</span>
          </a>

          <a href="#membership-form" class="focus-strip-item">
            <div class="focus-icon-circle">📚</div>
            <span class="focus-item-name">Training &amp; Skill Development</span>
          </a>

          <a href="#membership-form" class="focus-strip-item">
            <div class="focus-icon-circle">🤝</div>
            <span class="focus-item-name">Social Welfare Initiatives</span>
          </a>

          <a href="#membership-form" class="focus-strip-item">
            <div class="focus-icon-circle">🛡️</div>
            <span class="focus-item-name">Events &amp; Awareness Programs</span>
          </a>

          <a href="#membership-form" class="focus-strip-item">
            <div class="focus-icon-circle">🌐</div>
            <span class="focus-item-name">National Membership Network</span>
          </a>

          <a href="#membership-form" class="focus-strip-item">
            <div class="focus-icon-circle">🪪</div>
            <span class="focus-item-name">Official Membership ID Card</span>
          </a>
        </div>

        <div class="focus-tricolor-accent">
          <img src="assets/images/tricolor-wave.svg" alt="Indian Flag Ribbon">
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       SECTION 5 & 6 & 7 & 8: TWO-COLUMN MASTER ENGINE
       Left: About HRCI, Why Join, Video Gallery, Testimonials, Plans
       Right: Sticky Membership Lead Form
       ====================================================================== -->
  <section class="main-two-col-section" id="membership">
    <div class="container main-two-col-grid">
      
      <!-- LEFT CONTENT COLUMN -->
      <div class="col-left-main">
        
        <!-- About HRCI & Why Join Dual Block -->
        <div class="about-why-split-row" id="about">
          <!-- About Organization Box -->
          <div class="about-card-box" data-aos="fade-up">
            <div class="about-thumb-img">
              <img src="assets/images/hands-plant.jpg" alt="Humanity & Social Welfare" loading="lazy">
            </div>
            <h3>About <span style="color:var(--secondary);">HRCI</span></h3>
            <p class="about-card-desc">
              <strong>Human Rights Council of India (HRCI)</strong> is a registered, non-political, and secular NGO working under the leadership of Founder &amp; President <strong>Hon. Shri Haji S. Shaikh</strong> for the protection and promotion of human rights, education, health, legal support, and social welfare across India.
            </p>
            <div style="font-size:0.75rem;color:var(--text-muted);display:flex;align-items:center;gap:6px;">
              <span>🏛️ <strong>Regd. Section 8 (Govt. of India MCA)</strong></span>
            </div>
            <a href="#membership-form" class="btn btn-outline-blue btn-sm" style="align-self:flex-start;margin-top:auto;">
              Join Organization ➔
            </a>
          </div>

          <!-- Why Join HRCI Box -->
          <div class="why-join-box" id="why-join" data-aos="fade-up" data-aos-delay="100">
            <h3>Why Join <span style="color:var(--cta-red);">HRCI?</span></h3>
            <div class="why-check-list">
              <div class="why-check-item">
                <span class="green-tick">✓</span>
                <span>Be part of a trusted &amp; recognized national organization.</span>
              </div>
              <div class="why-check-item">
                <span class="green-tick">✓</span>
                <span>Work for Human Rights, Education, Health &amp; Social Welfare.</span>
              </div>
              <div class="why-check-item">
                <span class="green-tick">✓</span>
                <span>Get an Official Membership ID Card (Digital + Physical PVC).</span>
              </div>
              <div class="why-check-item">
                <span class="green-tick">✓</span>
                <span>Access to national programs, events &amp; legal training.</span>
              </div>
              <div class="why-check-item">
                <span class="green-tick">✓</span>
                <span>Expand your social &amp; professional network across 28 states.</span>
              </div>
              <div class="why-check-item">
                <span class="green-tick">✓</span>
                <span>Right to lead district &amp; state level social committees.</span>
              </div>
            </div>
            <a href="#membership-form" class="btn btn-primary-red btn-sm" style="align-self:flex-start;margin-top:auto;">
              Apply for Membership ➔
            </a>
          </div>
        </div>

        <!-- Section 7: Watch HRCI in Action (Video Gallery) -->
        <div class="video-gallery-card" id="videos" data-aos="fade-up">
          <div class="video-gallery-header">
            <div class="video-title-wrap">
              <span class="yt-red-icon">▶</span>
              <h4>Watch <strong>HRCI</strong> in Action</h4>
            </div>
            <div class="video-header-sub">
              Real events, real activities, real impact. Watch our latest videos on YouTube.
            </div>
            <a href="https://youtube.com/@HRC4India" target="_blank" rel="noopener" class="badge-pill badge-gold">
              @HRC4India
            </a>
          </div>

          <div class="video-cards-grid">
            <div class="video-card-item" data-video-id="dQw4w9WgXcQ" data-video-title="HRCI Global Peace Award 2026">
              <div class="video-thumb-container">
                <img src="assets/images/video-award.jpg" alt="HRCI Global Peace Award 2026" loading="lazy">
                <div class="video-play-btn">▶</div>
                <span class="video-duration-badge">8:24</span>
              </div>
              <div class="video-info-box">
                <div class="video-title">HRCI Global Peace Award 2026</div>
              </div>
            </div>

            <div class="video-card-item" data-video-id="dQw4w9WgXcQ" data-video-title="HRCI Global Peace Summit">
              <div class="video-thumb-container">
                <img src="assets/images/video-summit.jpg" alt="HRCI Global Peace Summit" loading="lazy">
                <div class="video-play-btn">▶</div>
                <span class="video-duration-badge">6:37</span>
              </div>
              <div class="video-info-box">
                <div class="video-title">HRCI Global Peace Summit</div>
              </div>
            </div>

            <div class="video-card-item" data-video-id="dQw4w9WgXcQ" data-video-title="Human Rights Awareness Conclave">
              <div class="video-thumb-container">
                <img src="assets/images/video-rally.jpg" alt="Human Rights Awareness" loading="lazy">
                <div class="video-play-btn">▶</div>
                <span class="video-duration-badge">5:18</span>
              </div>
              <div class="video-info-box">
                <div class="video-title">Human Rights Awareness</div>
              </div>
            </div>

            <div class="video-card-item" data-video-id="dQw4w9WgXcQ" data-video-title="HRCI Ground Social Welfare Work">
              <div class="video-thumb-container">
                <img src="assets/images/video-team.jpg" alt="HRCI Short Video" loading="lazy">
                <div class="video-play-btn">▶</div>
                <span class="video-duration-badge">0:59</span>
              </div>
              <div class="video-info-box">
                <div class="video-title">HRCI Social Impact Video</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Section 8: What Our Members Say (Testimonials Slider) -->
        <div class="testimonials-box" id="testimonials" data-aos="fade-up">
          <div class="testimonials-header">
            <div class="testimonials-title-group">
              <h3>What Our <strong>Members Say</strong></h3>
              <p>Real Stories • Real Impact • Trusted by 70,000+ Members</p>
            </div>
