                <li><span class="tick green-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="#16A34A"><path fill-rule="evenodd" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1.2 14.2l-3.5-3.5 1.41-1.41 2.09 2.08 5.3-5.3 1.41 1.42-6.71 6.71z"/></svg></span> Premium ID Card &amp; Certificate</li>
                <li><span class="tick green-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="#16A34A"><path fill-rule="evenodd" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1.2 14.2l-3.5-3.5 1.41-1.41 2.09 2.08 5.3-5.3 1.41 1.42-6.71 6.71z"/></svg></span> Priority in Events &amp; Programs</li>
                <li><span class="tick green-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="#16A34A"><path fill-rule="evenodd" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1.2 14.2l-3.5-3.5 1.41-1.41 2.09 2.08 5.3-5.3 1.41 1.42-6.71 6.71z"/></svg></span> Leadership Opportunities</li>
              </ul>
              <a href="#membership-form" class="btn btn-plan-solid-purple btn-plan-select" data-plan="Lifetime Membership (₹3,000)">
                Join Lifetime Membership →
              </a>
            </div>

            <!-- Plan 3: Executive Leadership -->
            <div class="pricing-card card-leadership-banner">
              <div class="plan-banner-pill pill-gold">
                <span class="plan-pill-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg></span> Executive / Leadership Membership
              </div>
              <div class="plan-price-wrap">
                <span class="price-val price-gold" style="font-size:1.15rem;">As per Designation</span>
                <span class="price-period">(National / State / District)</span>
              </div>
              <ul class="plan-features-list">
                <li><span class="tick green-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="#16A34A"><path fill-rule="evenodd" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1.2 14.2l-3.5-3.5 1.41-1.41 2.09 2.08 5.3-5.3 1.41 1.42-6.71 6.71z"/></svg></span> For Leaders, Professionals &amp; Social Workers</li>
                <li><span class="tick green-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="#16A34A"><path fill-rule="evenodd" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1.2 14.2l-3.5-3.5 1.41-1.41 2.09 2.08 5.3-5.3 1.41 1.42-6.71 6.71z"/></svg></span> Special Recognition &amp; Roles</li>
                <li><span class="tick green-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="#16A34A"><path fill-rule="evenodd" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1.2 14.2l-3.5-3.5 1.41-1.41 2.09 2.08 5.3-5.3 1.41 1.42-6.71 6.71z"/></svg></span> Priority Access to HRCI Initiatives</li>
                <li><span class="tick green-check"><svg width="16" height="16" viewBox="0 0 24 24" fill="#16A34A"><path fill-rule="evenodd" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1.2 14.2l-3.5-3.5 1.41-1.41 2.09 2.08 5.3-5.3 1.41 1.42-6.71 6.71z"/></svg></span> By Nomination / Approval Only</li>
