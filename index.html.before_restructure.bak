            </div>
            <div class="banner-step-arrow">➔</div>
            <div class="banner-step-item">
              <div class="step-card-bubble"><svg width="18" height="18" viewBox="0 0 24 24" fill="#0B3D91"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"/></svg></div>
              <span class="step-card-text">Get<br>Details</span>
            </div>
            <div class="banner-step-arrow">➔</div>
            <div class="banner-step-item">
              <div class="step-card-bubble"><svg width="18" height="18" viewBox="0 0 24 24" fill="#0B3D91"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.1-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/></svg></div>
              <span class="step-card-text">Choose<br>Plan</span>
            </div>
            <div class="banner-step-arrow">➔</div>
            <div class="banner-step-item step-highlight">
              <div class="step-card-bubble green-bubble"><svg width="18" height="18" viewBox="0 0 24 24" fill="#FFFFFF"><path fill-rule="evenodd" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1.2 14.2l-3.5-3.5 1.41-1.41 2.09 2.08 5.3-5.3 1.41 1.42-6.71 6.71z"/></svg></div>
              <span class="step-card-text">Become<br>HRCI Member</span>
            </div>
          </div>
        </div>

        <!-- Floating Official PVC ID Card Sample Teaser -->
        <div class="id-card-sample-teaser" data-aos="fade-up">
          <div class="id-sample-badge">
            <span class="badge-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="#0B3D91"><path d="M19 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.89-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm6 12H6v-1c0-2 4-3.1 6-3.1s6 1.1 6 3.1v1z"/></svg></span>
            <div class="id-sample-text">
              <strong>Official PVC ID Card</strong>
              <small>Equipped with QR Verification &amp; Govt. Regd. Seal</small>
            </div>
          </div>
          <button type="button" class="btn-sample-preview btn-trigger-id-modal">
            View Sample ID Card <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px;margin-left:4px;"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
          </button>
        </div>
      </aside>

    </div>
  </section>

