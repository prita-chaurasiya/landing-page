      <!-- RIGHT STICKY COLUMN: SECTION 10 - CRO MEMBERSHIP LEAD FORM -->
      <aside class="sticky-sidebar-col" id="membership-form">
        <div class="lead-form-card" data-aos="fade-left">
          <div class="form-card-header">
            <div class="form-header-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="#F8B400"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg></div>
            <div>
              <h3>Join HRCI Today</h3>
              <p>Start Your Official Membership Journey</p>
            </div>
          </div>

          <form id="hrciLeadForm" class="membership-form-element">
            <div class="form-group">
              <label for="fullName">Full Name <span class="req">*</span></label>
              <div class="input-icon-wrap">
                <span class="input-ico"><svg width="15" height="15" viewBox="0 0 24 24" fill="#64748B"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></span>
                <input type="text" id="fullName" name="fullName" class="form-control" placeholder="Enter Full Name" required>
              </div>
            </div>

            <div class="form-group">
              <label for="whatsappNumber">WhatsApp Number <span class="req">*</span></label>
              <div class="input-icon-wrap">
                <span class="input-ico"><svg width="15" height="15" viewBox="0 0 24 24" fill="#25D366"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg></span>
                <input type="tel" id="whatsappNumber" name="whatsappNumber" class="form-control" placeholder="e.g. 9876543210" required pattern="[0-9]{10}">
              </div>
            </div>

            <div class="form-group">
              <label for="cityState">City / State <span class="req">*</span></label>
              <div class="input-icon-wrap">
                <span class="input-ico"><svg width="15" height="15" viewBox="0 0 24 24" fill="#64748B"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg></span>
                <input type="text" id="cityState" name="cityState" class="form-control" placeholder="Enter City &amp; State" required>
              </div>
            </div>

            <div class="form-group">
              <label for="membershipType">Membership Type <span class="req">*</span></label>
              <div class="input-icon-wrap">
                <span class="input-ico"><svg width="15" height="15" viewBox="0 0 24 24" fill="#64748B"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg></span>
                <select id="membershipType" name="membershipType" class="form-control" required>
                  <option value="" disabled selected>Select Membership Type</option>
                  <option value="Annual Membership (₹600)">Annual Membership — ₹600 / Year</option>
                  <option value="Lifetime Membership (₹3,000)">Lifetime Membership — ₹3,000 (One-Time)</option>
                  <option value="Executive / Leadership Wing">Executive / Leadership Membership</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="profession">Profession / Occupation <span class="req">*</span></label>
              <div class="input-icon-wrap">
                <span class="input-ico"><svg width="15" height="15" viewBox="0 0 24 24" fill="#64748B"><path d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"/></svg></span>
                <input type="text" id="profession" name="profession" class="form-control" placeholder="Doctor, Advocate, Social Worker, Business..." required>
              </div>
              <small class="helper-text">e.g. Doctor, Advocate, Social Worker, Teacher, Business, Politician etc.</small>
            </div>

            <button type="submit" class="btn btn-primary-red btn-submit-lead">
              <span>Get Membership Details</span>
              <span>➔</span>
            </button>
          </form>

          <!-- Form Trust Footer -->
          <div class="form-trust-badges">
            <div class="trust-badge-row">
              <span class="lock-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="#16A34A"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg></span>
              <span>Your information is 100% safe &amp; secure.</span>
            </div>
            <div class="trust-sub-row">
              <span><svg width="12" height="12" viewBox="0 0 24 24" fill="#16A34A" style="vertical-align:-1px;margin-right:3px;"><path fill-rule="evenodd" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1.2 14.2l-3.5-3.5 1.41-1.41 2.09 2.08 5.3-5.3 1.41 1.42-6.71 6.71z"/></svg>Instant WhatsApp Confirmation</span>
              <span><svg width="12" height="12" viewBox="0 0 24 24" fill="#16A34A" style="vertical-align:-1px;margin-right:3px;"><path fill-rule="evenodd" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1.2 14.2l-3.5-3.5 1.41-1.41 2.09 2.08 5.3-5.3 1.41 1.42-6.71 6.71z"/></svg>Govt. Regd. NGO</span>
            </div>
          </div>
        </div>

        <!-- Simple Membership Process (Positioned Directly Under Form Matching Image 4) -->
        <div class="simple-process-banner-card" id="process" data-aos="fade-up">
          <div class="process-banner-header">
            Simple Membership Process
          </div>
          <div class="process-banner-steps">
            <div class="banner-step-item">
              <div class="step-card-bubble"><svg width="18" height="18" viewBox="0 0 24 24" fill="#0B3D91"><path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg></div>
